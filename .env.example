# Groq model name
LLM_MODEL=

# Required: Groq API key (get one at console.groq.com)
GROQ_API_KEY=

# Chunking parameters
CHUNK_SIZE=700
OVERLAP_PCT=0.12

# Retrieval top-k
TOP_K=5

# Data directories
RAW_DATA_DIR=data/raw
CHROMA_DIR=data/chroma

# URLs to scrape are listed in sources.txt (one per line).
# Override with SOURCES_FILE=path/to/file or supply extra URLs via SOURCE_URLS=url1,url2.
