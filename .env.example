# Groq model name
LLM_MODEL=

# Required: Groq API key (get one at console.groq.com)
GROQ_API_KEY=

# Chunking parameters
CHUNK_SIZE=700
OVERLAP_PCT=0.12

# Retrieval top-k
TOP_K=5

# Data directories
RAW_DATA_DIR=data/raw
CHROMA_DIR=data/chroma

# Comma-separated list of UMass HR URLs to scrape
SOURCE_URLS=https://www.umass.edu/hr/,https://www.umass.edu/hr/benefits,https://www.umass.edu/hr/benefits-and-pay/employee-benefits/askhr, https://www.umass.edu/hr/benefits-and-pay/payroll/taxes, https://www.umass.edu/hr/documents/fica-exemption-certificate
